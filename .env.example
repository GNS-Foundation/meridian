# Meridian — env var NAMES only (no values). Copy to .env and fill locally; .env is git-ignored.
# All Grafomem credentials come from ENV — never chat, never committed.

# Grafomem public API base (e.g. https://api.grafomem.com)
MERIDIAN_GRAFOMEM_API=

# The `virtualbank` tenant API key, captured from the provisioning SQL's NOTICE output.
# Scopes include cgr:read (read reputation back) + decisions:read (substrate for the evidence pack).
MERIDIAN_GRAFOMEM_API_KEY=

# The virtualbank tenant_id (from the provisioning NOTICE) — used only for RLS/isolation checks.
MERIDIAN_TENANT_ID=

# Optional: User-Agent for the API client (the prod edge may filter default UAs).
# MERIDIAN_HTTP_USER_AGENT=
